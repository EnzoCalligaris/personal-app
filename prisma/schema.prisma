// Prisma schema - Plataforma Personal Trainer x Aluno
// Banco: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PERSONAL
  ALUNO
}

enum DiaSemana {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

enum StatusAluno {
  ATIVO
  INATIVO
}

enum StatusAgendamento {
  // Marcado, à espera do aceite do Personal.
  AGENDADO
  // Confirmado pelo Personal.
  CONFIRMADO
  CANCELADO
  REALIZADO
  // Movido de horário - continua valendo, à espera de confirmação.
  REAGENDADO
}

enum TipoNotificacao {
  NOVO_TREINO
  TREINO_ALTERADO
  NOVO_AGENDAMENTO
  AGENDAMENTO_CONFIRMADO
  AGENDAMENTO_CANCELADO
  AGENDAMENTO_REAGENDADO
  NOVA_AVALIACAO
  NOVO_FEEDBACK
  LEMBRETE
}

model User {
  // Mesmo id do usuário no Supabase Auth (auth.users.id) - não gerado pelo Prisma.
  id        String   @id @db.Uuid
  email     String   @unique
  name      String
  role      Role
  avatarUrl String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Perfil Personal Trainer
  personalProfile PersonalProfile?

  // Perfil Aluno
  alunoProfile AlunoProfile?

  notificacoes Notificacao[]

  @@map("users")
}

model PersonalProfile {
  id     String  @id @default(uuid())
  userId String  @unique @db.Uuid
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio    String?
  cref   String? // registro profissional

  configAgenda     ConfiguracaoAgenda?
  alunos           AlunoProfile[]
  exercicios       Exercicio[]
  treinos          Treino[]
  disponibilidades Disponibilidade[]
  bloqueios        Bloqueio[]
  agendamentos     Agendamento[]
  avaliacoes       Avaliacao[]
  feedbacks        Feedback[]
  programacoes     Programacao[]

  @@map("personal_profiles")
}

model AlunoProfile {
  id         String           @id @default(uuid())
  userId     String           @unique @db.Uuid
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalId String?
  personal   PersonalProfile? @relation(fields: [personalId], references: [id], onDelete: SetNull)

  dataNascimento DateTime? @db.Date
  altura         Float? // cm
  objetivo       String?
  observacoes    String?
  // Controlado pelo Personal (desativar/reativar). Aluno inativo mantém todo
  // o histórico - nada é apagado.
  status         StatusAluno @default(ATIVO)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  treinos      Treino[]
  historico    HistoricoTreino[]
  agendamentos Agendamento[]
  avaliacoes   Avaliacao[]
  feedbacks    Feedback[]
  programacoes Programacao[]

  @@index([personalId])
  @@index([personalId, status])
  @@map("aluno_profiles")
}

model Exercicio {
  id            String          @id @default(uuid())
  personalId    String
  personal      PersonalProfile @relation(fields: [personalId], references: [id], onDelete: Cascade)
  nome          String
  grupoMuscular String
  descricao     String?
  videoUrl      String?
  imagemUrl     String?
  // Arquivar em vez de excluir: exercício já usado em treinos não pode ser
  // apagado (a FK é em cascata e o esvaziaria das fichas), mas pode sair da
  // biblioteca ativa.
  ativo         Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  treinoExercicios TreinoExercicio[]
  historico        HistoricoExercicio[]

  @@index([personalId])
  @@index([personalId, ativo])
  @@map("exercicios")
}

model Treino {
  id          String          @id @default(uuid())
  personalId  String
  personal    PersonalProfile @relation(fields: [personalId], references: [id], onDelete: Cascade)
  alunoId     String
  aluno       AlunoProfile    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  nome        String
  observacoes String?
  ativo       Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  exercicios TreinoExercicio[]
  historico  HistoricoTreino[]
  // Em quais dias este treino é prescrito (a programação é quem define isso;
  // o mesmo treino pode aparecer em vários dias).
  diasProgramados ProgramacaoDia[]

  @@index([personalId])
  @@index([alunoId])
  @@map("treinos")
}

/// Período em que uma rotina semanal vale para o aluno. Trocar a rotina é
/// criar uma nova programação - o histórico das anteriores fica preservado.
model Programacao {
  id          String          @id @default(uuid())
  personalId  String
  personal    PersonalProfile @relation(fields: [personalId], references: [id], onDelete: Cascade)
  alunoId     String
  aluno       AlunoProfile    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  nome        String?
  /// Datas puras (sem hora): o que vale é o dia do calendário.
  dataInicio  DateTime        @db.Date
  /// Nulo = vigente por tempo indeterminado.
  dataFim     DateTime?       @db.Date
  observacoes String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  dias ProgramacaoDia[]

  @@index([personalId])
  @@index([alunoId, dataInicio])
  @@map("programacoes")
}

/// Um dia da semana dentro de uma programação. A ausência de linha para um
/// dia significa descanso.
model ProgramacaoDia {
  id            String      @id @default(uuid())
  programacaoId String
  programacao   Programacao @relation(fields: [programacaoId], references: [id], onDelete: Cascade)
  diaSemana     DiaSemana
  treinoId      String
  treino        Treino      @relation(fields: [treinoId], references: [id], onDelete: Cascade)

  @@unique([programacaoId, diaSemana])
  @@index([treinoId])
  @@map("programacao_dias")
}

model TreinoExercicio {
  id          String    @id @default(uuid())
  treinoId    String
  treino      Treino    @relation(fields: [treinoId], references: [id], onDelete: Cascade)
  exercicioId String
  exercicio   Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  ordem       Int
  series      Int
  repeticoes  String // ex: "8-12" ou "15"
  carga       String? // ex: "20kg" ou "peso corporal"
  descansoSeg Int?
  observacoes String?

  @@unique([treinoId, ordem])
  @@index([exercicioId])
  @@map("treino_exercicios")
}

model HistoricoTreino {
  id           String       @id @default(uuid())
  // O histórico é do aluno: ele registra o que foi feito, não a ficha que
  // originou. Se o Personal excluir a ficha, a referência some (SetNull) e o
  // registro continua de pé, contando pelo retrato abaixo.
  treinoId     String?
  treino       Treino?      @relation(fields: [treinoId], references: [id], onDelete: SetNull)
  /** Nome da ficha no momento da execução - sobrevive à exclusão dela. */
  treinoNome   String
  alunoId      String
  aluno        AlunoProfile @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  dataExecucao DateTime     @default(now())
  concluido    Boolean      @default(true)
  observacoes  String?
  // Duração da sessão, cronometrada pela tela de execução. Fica nulo quando o
  // treino é marcado como feito sem passar pela sessão.
  duracaoSeg   Int?

  itens HistoricoExercicio[]

  @@index([treinoId])
  @@index([alunoId, dataExecucao])
  @@map("historico_treinos")
}

/**
 * O que foi de fato realizado em cada exercício da sessão. Os dados são um
 * retrato do momento (nome, séries, repetições, carga): a ficha pode ser
 * editada ou apagada depois, e o histórico precisa continuar verdadeiro.
 */
model HistoricoExercicio {
  id          String          @id @default(uuid())
  historicoId String
  historico   HistoricoTreino @relation(fields: [historicoId], references: [id], onDelete: Cascade)
  // Referência à biblioteca, para futuras estatísticas por exercício. Some
  // se o exercício for excluído - o retrato abaixo permanece.
  exercicioId String?
  exercicio   Exercicio?      @relation(fields: [exercicioId], references: [id], onDelete: SetNull)

  ordem         Int
  nome          String
  grupoMuscular String
  // O que o aluno realmente fez (parte da prescrição, parte ajustada por ele).
  series        Int
  repeticoes    String
  carga         String?
  concluido     Boolean @default(true)
  observacoes   String?

  @@unique([historicoId, ordem])
  @@index([exercicioId])
  @@map("historico_exercicios")
}

model Disponibilidade {
  id         String          @id @default(uuid())
  personalId String
  personal   PersonalProfile @relation(fields: [personalId], references: [id], onDelete: Cascade)
  diaSemana  DiaSemana
  horaInicio String // "08:00"
  horaFim    String // "18:00"
  duracaoMin Int             @default(60)

  @@unique([personalId, diaSemana, horaInicio])
  @@map("disponibilidades")
}

/**
 * Regras que o Personal define para o aluno marcar sozinho. Sem linha, valem
 * os padrões de src/lib/agenda/regras.ts.
 */
model ConfiguracaoAgenda {
  id         String          @id @default(uuid())
  personalId String          @unique
  personal   PersonalProfile @relation(fields: [personalId], references: [id], onDelete: Cascade)

  /// O aluno pode marcar horário sozinho.
  permiteAgendamento    Boolean @default(true)
  /// Horas de antecedência mínima para marcar.
  antecedenciaMinHoras  Int     @default(12)
  /// Até quantos dias à frente o aluno pode marcar.
  janelaDias            Int     @default(30)
  /// Horas de antecedência mínima para cancelar ou reagendar.
  cancelamentoMinHoras  Int     @default(12)
  /// Quantos atendimentos futuros o aluno pode ter marcados ao mesmo tempo.
  maxAtivosPorAluno     Int     @default(3)
  /// Duração sugerida de cada atendimento ao criar uma faixa de trabalho.
  duracaoPadraoMin      Int     @default(60)
  /// O agendamento do aluno já nasce confirmado (senão fica à espera do aceite).
  confirmacaoAutomatica Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("configuracoes_agenda")
}

/**
 * Horário em que o Personal não atende: férias, compromisso pessoal, almoço.
 * Sem hora de início e fim, o dia inteiro está bloqueado. "Liberar horário" é
 * apagar o bloqueio.
 */
model Bloqueio {
  id         String          @id @default(uuid())
  personalId String
  personal   PersonalProfile @relation(fields: [personalId], references: [id], onDelete: Cascade)
  data       DateTime        @db.Date
  horaInicio String?
  horaFim    String?
  motivo     String?
  createdAt  DateTime        @default(now())

  @@index([personalId, data])
  @@map("bloqueios")
}

model Agendamento {
  id          String            @id @default(uuid())
  personalId  String
  personal    PersonalProfile   @relation(fields: [personalId], references: [id], onDelete: Cascade)
  alunoId     String
  aluno       AlunoProfile      @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  data        DateTime          @db.Date
  horaInicio  String
  horaFim     String
  status      StatusAgendamento @default(AGENDADO)
  observacoes String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([personalId, data])
  @@index([alunoId, data])
  @@map("agendamentos")

  /// ATENÇÃO: esta tabela tem uma EXCLUDE constraint que o Prisma não
  /// representa - "agendamentos_sem_sobreposicao" impede que dois
  /// atendimentos ATIVOS (AGENDADO, CONFIRMADO, REAGENDADO) do mesmo Personal
  /// se sobreponham no mesmo dia. Ela é criada pela migration
  /// 20260909120000_agenda_sem_sobreposicao e é o que fecha a corrida entre
  /// "verifiquei que estava livre" e "gravei". Não a remova ao editar este
  /// modelo: o "prisma migrate dev" não a recria sozinho.
}

model Avaliacao {
  id                String          @id @default(uuid())
  personalId        String
  personal          PersonalProfile @relation(fields: [personalId], references: [id], onDelete: Cascade)
  alunoId           String
  aluno             AlunoProfile    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  data              DateTime        @default(now()) @db.Date
  // Nenhuma medida é obrigatória: cada balança entrega um conjunto diferente,
  // e o que o equipamento não mediu fica nulo em vez de virar zero.
  peso              Float? // kg
  imc               Float?
  percentualGordura Float? // %
  massaGorda        Float? // kg
  massaMagra        Float? // kg
  massaMuscular     Float? // kg (massa muscular esquelética)
  massaOssea        Float? // kg
  aguaPercentual    Float? // % do peso
  aguaLitros        Float? // litros
  gorduraVisceral   Float? // nível informado pela balança
  metabolismoBasal  Int? // kcal/dia
  idadeMetabolica   Int? // anos
  observacoes       String?
  medidas           Json? // { peito, cintura, quadril, braco, coxa, ... }
  fotos             String[]        @default([])

  feedbacks Feedback[]

  @@index([personalId])
  @@index([alunoId, data])
  @@map("avaliacoes")
}

/// Comentário do Personal para um aluno. O autor é sempre o Personal - o
/// aluno lê e o sistema marca quando ele leu.
model Feedback {
  id          String          @id @default(uuid())
  personalId  String
  personal    PersonalProfile @relation(fields: [personalId], references: [id], onDelete: Cascade)
  alunoId     String
  aluno       AlunoProfile    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  avaliacaoId String?
  avaliacao   Avaliacao?      @relation(fields: [avaliacaoId], references: [id], onDelete: SetNull)
  texto       String
  /// Quando o aluno abriu o feedback. Nulo = ainda não lido.
  lidoEm      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt @default(now())

  @@index([personalId])
  @@index([alunoId, createdAt])
  @@index([avaliacaoId])
  @@map("feedbacks")
}

model Notificacao {
  id        String          @id @default(uuid())
  userId    String          @db.Uuid
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo      TipoNotificacao
  titulo    String
  mensagem  String
  lida      Boolean         @default(false)
  link      String?
  createdAt DateTime        @default(now())

  @@index([userId, lida])
  @@index([userId, createdAt])
  @@map("notificacoes")
}
