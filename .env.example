# Copie para `.env` e preencha. Nenhum valor deste arquivo é secreto - ele é
# um modelo. O `.env` de verdade fica fora do git (ver .gitignore).
#
# Local:     `npm run supabase:start` imprime todos os valores abaixo.
#            Para reimprimir depois: `npm run supabase:status`.
# Produção:  painel do Supabase (Settings → API e Settings → Database).

# =============================================================================
# Supabase (autenticação e storage)
# =============================================================================

# Settings → API → Project URL. Vai para o bundle do navegador (público).
NEXT_PUBLIC_SUPABASE_URL=

# Settings → API → `anon` `public`. Também vai para o navegador: é pública por
# projeto e sozinha não dá acesso a nada - quem decide é a política do banco.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Settings → API → `service_role`. SEGREDO. Contorna qualquer política e
# gerencia contas do Auth. Só é lida no servidor (src/lib/supabase/admin.ts,
# que importa `server-only`). Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# Banco de dados (Postgres do Supabase)
# =============================================================================

# Usada pela aplicação em execução. Em produção, aponte para o
# **connection pooling** (Settings → Database → Connection pooling, porta
# 6543): o servidor abre e fecha conexões a cada requisição e o pooler evita
# estourar o limite do Postgres.
DATABASE_URL=

# Usada só pelo Prisma CLI (`db:migrate`, `db:deploy`, `db:studio`), que
# precisa de conexão direta - migrations não funcionam através do pooler.
# Em produção é a porta 5432. Localmente as duas são iguais.
DIRECT_URL=

# O endereço público da aplicação - a origem confiável dos links que SAEM dela,
# hoje o de recuperação de senha. Precisa ser absoluta, com protocolo, sem
# caminho (ex.: https://app.seudominio.com). Localmente, http://localhost:3000.
#
# Não é montada a partir do Host da requisição de propósito: esse header vem do
# cliente, e um Host forjado faria chegar à caixa da vítima um link para o
# domínio do atacante com um token de recuperação válido dentro.
#
# O mesmo endereço precisa estar autorizado no Supabase Auth, em
# Authentication -> URL Configuration (Site URL e Redirect URLs), incluindo o
# callback /auth/callback. Localmente isso já está em supabase/config.toml.
NEXT_PUBLIC_SITE_URL=

# =============================================================================
# Opcionais
# =============================================================================

# `1` faz o Prisma emitir um evento por consulta. Os testes de orçamento ligam
# sozinhos (tests/setup.ts); em produção deixe desligado.
# PRISMA_LOG_QUERIES=0

# `1` libera os seeds de dados de teste contra um banco não-local. Eles criam
# contas com senha pública - só use num ambiente descartável.
# PERMITIR_SEED_REMOTO=0

# OBRIGATÓRIA EM PRODUÇÃO. Qual header a infraestrutura à frente da aplicação
# sobrescreve com o endereço do cliente, para o limite de tentativas das rotas
# de autenticação: x-forwarded-for atrás de nginx/Traefik, cf-connecting-ip
# atrás da Cloudflare.
#
# Definir esta variável é uma AFIRMAÇÃO: "algo na minha frente reescreve esse
# header a cada requisição". Se a aplicação estiver exposta direto na internet,
# não existe valor correto - o cliente escolheria o próprio endereço e o limite
# por IP não valeria nada. Nesse caso, ponha um proxy na frente.
#
# Sem ela, em produção as rotas de autenticação falham alto em vez de aplicar
# uma proteção que não protege. Em desenvolvimento não é necessária: sem proxy,
# todos os pedidos caem num balde único.
#
# O servidor usado pelos testes sobe com "next start" (NODE_ENV=production),
# então mantenha-a preenchida no .env local.
RATE_LIMIT_IP_HEADER=x-forwarded-for
