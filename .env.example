# Supabase
# Local: rode `npm run supabase:start` e copie os valores impressos
# (API_URL, ANON_KEY, SERVICE_ROLE_KEY). Produção: Settings > API do projeto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma (Postgres via Supabase)
# Local: use o mesmo valor de DB_URL impresso por `npm run supabase:start`
# em ambos (Postgres local não usa pooler). Produção: connection pooling
# (pgbouncer, porta 6543) em DATABASE_URL e conexão direta (porta 5432,
# usada pelo Prisma CLI) em DIRECT_URL.
DATABASE_URL=
DIRECT_URL=
